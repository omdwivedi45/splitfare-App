# ── SplitFare Backend Environment Variables ──
# Copy this file to .env and fill in all values

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/splitfare?retryWrites=true&w=majority

# JWT Secret - use a long random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Razorpay Payment Gateway
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary (for image uploads - gov ID, selfie, vehicle photos)
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps API Key (for geocoding & directions)
# Get from: https://console.cloud.google.com → APIs & Services
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key
