# ── SplitFare Frontend Environment Variables ──
# Copy this to .env and fill in values

# Your deployed backend URL (Railway/Render)
VITE_API_URL=https://splitfare-backend.railway.app/api

# Socket.IO server URL (same as backend)
VITE_SOCKET_URL=https://splitfare-backend.railway.app

# Google Maps API key (same as backend env)
VITE_GOOGLE_MAPS_KEY=AIzaSy_your_google_maps_api_key
